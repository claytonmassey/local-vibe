# Web (apps/web). Copy to apps/web/.env.local. Do not put real secrets in git.

# Leave unset. Setting this to true without an approved Stripe account locks checkout.
SELLING_ENABLED=

# Optional. The webhook verifies signatures and never grants access by itself
# unless a Stripe-mode order already exists and the amount matches.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional later: Postgres replaces the local file store. The SQL migration is
# packages/db/migrations/0001_init.sql. The running app does not read this yet.
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Comma-free origin for the Expo app when it calls the API from another host.
CORS_ORIGIN=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000
