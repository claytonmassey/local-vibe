{
  "expo": {
    "name": "MarketMap",
    "slug": "marketmap",
    "scheme": "marketmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marketmap.planner"
    },
    "android": {
      "package": "com.marketmap.planner"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {}
    }
  }
}
